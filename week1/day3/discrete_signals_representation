clc;
clear;
close all;

n = -10:10;
x = sin(0.3*pi*n);

figure;

% 1. Graphical Representation
subplot(3,3,1);
stem(n, x, 'filled');
title('Graphical Representation');
xlabel('n'); ylabel('x[n]');
grid on;

% 2. Functional Representation
subplot(3,3,2);
plot(n, x, 'LineWidth', 2);
title('Functional Representation');
xlabel('n'); ylabel('x[n]');
grid on;

% 3. Tabular Representation                             
disp('Tabular Representation:');
disp(table(n', x', 'VariableNames', {'n','x[n]'}));

% 4. Sequence Representation
subplot(3,3,3);
stem(n, x, 'filled');
title('Sequence Representation');
xlabel('n'); ylabel('x[n]');
grid on



