clc;
clear;
close all;

n = -5:5;

% Original signal (example)
x = (n >= -2 & n <= 4);   % simple box

% Time reversed signal
x_rev = fliplr(x);

% Even component
x_even = 0.5 * (x + x_rev);

figure;

subplot(3,1,1);
stem(n, x, 'filled');
title('Original Signal x[n]');
xlabel('n'); ylabel('Amplitude');
grid on;
ylim([0 2.5]);

subplot(3,1,2);
stem(n, x_rev, 'filled');
title('Reversed Signal x[-n]');
xlabel('n'); ylabel('Amplitude');
grid on;
ylim([0 2.5]);

subplot(3,1,3);
stem(n, x_even, 'filled');
title('Even Component');
xlabel('n'); ylabel('Amplitude');
grid on;
ylim([0 2.5]);
